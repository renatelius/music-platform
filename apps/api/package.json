{
  "name": "@mp/api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API: modular monolith on NestJS (REST + WebSocket)",
  "type": "module",
  "exports": {
    "./catalog": {
      "types": "./dist/catalog/ingest.d.ts",
      "default": "./dist/catalog/ingest.js"
    },
    "./config": {
      "types": "./dist/config/env.d.ts",
      "default": "./dist/config/env.js"
    },
    "./db": {
      "types": "./dist/db/client.d.ts",
      "default": "./dist/db/client.js"
    },
    "./infra": {
      "types": "./dist/infra/clients.d.ts",
      "default": "./dist/infra/clients.js"
    },
    "./media": {
      "types": "./dist/media/index.d.ts",
      "default": "./dist/media/index.js"
    },
    "./migrate": {
      "types": "./dist/db/migrate.d.ts",
      "default": "./dist/db/migrate.js"
    },
    "./pipeline": {
      "types": "./dist/worker/pipeline.d.ts",
      "default": "./dist/worker/pipeline.js"
    },
    "./storage": {
      "types": "./dist/worker/storage.d.ts",
      "default": "./dist/worker/storage.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node scripts/dev.mjs",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "worker": "node --env-file-if-exists=../../.env dist/worker/main.js",
    "worker:smoke": "node --env-file-if-exists=../../.env dist/worker/smoke-cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env dist/db/migrate-cli.js",
    "db:migrate:test": "node --env-file-if-exists=../../.env dist/db/migrate-cli.js --test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@mp/contracts": "workspace:*",
    "@nestjs/common": "^12.3.3",
    "@nestjs/core": "^12.3.3",
    "@nestjs/platform-express": "^12.3.3",
    "bullmq": "~6.5.3",
    "drizzle-orm": "^0.45.4",
    "helmet": "^8.3.0",
    "ioredis": "^5.6.0",
    "jose": "^6.2.15",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@mp/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
