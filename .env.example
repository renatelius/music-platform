# Local development settings. Copy to .env (setup.bat does it automatically).
# These values are for LOCAL DEVELOPMENT ONLY. Never use them in production.
NODE_ENV=development

# PostgreSQL 18 + pgvector
POSTGRES_USER=mp
POSTGRES_PASSWORD=mp_dev_password
POSTGRES_DB=mp
POSTGRES_PORT=54320
DATABASE_URL=postgres://mp:mp_dev_password@127.0.0.1:54320/mp
DATABASE_URL_TEST=postgres://mp:mp_dev_password@127.0.0.1:54320/mp_test

# Redis
REDIS_PASSWORD=mp_dev_redis
REDIS_PORT=63790
REDIS_URL=redis://:mp_dev_redis@127.0.0.1:63790/0

# S3-compatible storage (SeaweedFS locally).
# Keys must match infrastructure/docker/seaweedfs/s3.json
S3_PORT=8333
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=mp_dev_access
S3_SECRET_ACCESS_KEY=mp_dev_secret_change_me
S3_FORCE_PATH_STYLE=true
S3_BUCKET_MEDIA=mp-media
S3_BUCKET_MASTERS=mp-masters

# Mail (Mailpit catches all emails locally, UI: http://127.0.0.1:8025)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# API (apps/api). All values below have defaults; listed for reference.
API_HOST=127.0.0.1
API_PORT=4000
API_PUBLIC_URL=http://127.0.0.1:4000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# loopback: trust X-Forwarded-For only from a proxy on this machine (the web app)
TRUST_PROXY=loopback
LOG_LEVEL=log
LOG_FORMAT=pretty
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# Auth. setup.bat replaces this placeholder with a random secret in your .env.
# The API refuses to start in production with a placeholder.
AUTH_JWT_SECRET=dev_only_jwt_secret_change_me_0123456789abcdef
AUTH_ACCESS_TTL_SEC=900
AUTH_REFRESH_TTL_DAYS=30
# The web app proxies the API under /api, so the browser sees the refresh endpoint at /api/auth.
AUTH_COOKIE_PATH=/api/auth

# Links in emails point to the web app.
WEB_APP_URL=http://localhost:3000
MAIL_FROM=ReMusic <no-reply@remusic.local>
SMTP_SECURE=false

# FFmpeg for the audio pipeline. Found on PATH by default; uncomment to use another install.
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe

# Worker: parallel jobs, Redis key prefix of the queues, minimum track length.
WORKER_CONCURRENCY=2
QUEUE_PREFIX=mp
INGEST_MIN_DURATION_SEC=30

# Web app (apps/web): where its server reaches the API.
API_INTERNAL_URL=http://127.0.0.1:4000
